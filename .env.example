# Application
APP_NAME=SearPHP
APP_URL=http://localhost:8080
APP_DEBUG=false

# HTTP behaviour
HTTP_TIMEOUT_MS=1800
HTTP_BUDGET_MS=2600
HTTP_CONNECT_TIMEOUT_MS=800
HTTP_MAX_BYTES=2097152
HTTP_MAX_REDIRECTS=3

# CORS: "*" or a comma-separated origin allowlist
CORS_ORIGINS=*
CORS_MAX_AGE=86400

# Rate limit (no API keys, no database)
RATE_LIMIT=120
RATE_WINDOW=60
TRUST_PROXY=false

# PHP file cache only
CACHE_DRIVER=file
CACHE_TTL=600
CACHE_IMAGE_TTL=1800

# Engines (all free, no keys)
ENGINE_DDG=true
ENGINE_DDG_LITE=true
ENGINE_BING=true
ENGINE_BRAVE=true
ENGINE_WIKIPEDIA=true
ENGINE_DDG_INSTANT=true
ENGINE_DDG_IMAGES=true
ENGINE_BING_IMAGES=true
ENGINE_BRAVE_IMAGES=false

# MCP endpoint at POST /mcp
MCP_ENABLED=true

# Logging
LOG_ENABLED=true
LOG_QUERIES=false
LOG_MAX_BYTES=5242880
